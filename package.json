{
  "name": "CampusFix",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:unit": "vitest tests/unit",
    "test:rules": "firebase emulators:exec --project demo-campusfix-rules-test --only firestore,storage \"npm run test:rules:emulator\"",
    "test:rules:emulator": "vitest run tests/rules",
    "lint": "eslint ."
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/vue": "^9.0.0",
    "@ionic/vue-router": "^9.0.0",
    "chart.js": "^4.5.1",
    "firebase": "^13.0.0",
    "ionicons": "^8.1.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.0",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.3.0",
    "cypress": "^13.5.0",
    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "jsdom": "^22.1.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "~4.0.18",
    "vue-tsc": "^2.1.10"
  },
  "description": "An Ionic project"
}
